{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterion.local/schemas/generated_practice.schema.json",
  "title": "Asterion Content Lab Generated Practice Schema Contract v2",
  "description": "Reviewed, deterministic, non-exam warm-up practice generated repo-side for static runtime use. v2 adds optional Question-to-Lesson metadata while preserving legacy runtime parsing. difficulty_band is deprecated metadata; runtime readiness is controlled by sequence_role, verification, and review_status.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "generated_by", "items"],
  "properties": {
    "schema_name": { "const": "asterion_generated_practice" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "artifact_scope": { "enum": ["runtime", "internal_planning"] },
    "scope_note": { "type": "string", "minLength": 1 },
    "runtime_reviewed_count": { "type": "integer", "minimum": 0 },
    "published_runtime_count": { "type": "integer", "minimum": 0 },
    "internal_candidate_count": { "type": "integer", "minimum": 0 },
    "needs_review_internal_count": { "type": "integer", "minimum": 0 },
    "blocked_candidate_count": { "type": "integer", "minimum": 0 },
    "verification_failure_count": { "type": "integer", "minimum": 0 },
    "missing_example_model_id_count": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "practice_id",
          "generator_family",
          "paper_family",
          "topic",
          "prompt",
          "answer",
          "worked_solution",
          "parameters",
          "sequence_role",
          "verification",
          "difficulty_band",
          "review_status"
        ],
        "properties": {
          "practice_id": { "type": "string", "pattern": "^[a-z0-9_:-]+$" },
          "generator_family": {
            "enum": [
              "algebra.binomial_validity_range",
              "algebra.modulus_equation_basic",
              "algebra.partial_fractions_distinct_linear",
              "algebra.partial_fractions_repeated_linear",
              "algebra.polynomial_remainder_factor_basic",
              "algebra.structure_first_bridge",
              "algebra.structure_rearrangement_basic",
              "binomial_expansion.first_terms_and_coefficient",
              "complex_numbers.cartesian_conjugate_basic",
              "complex_numbers.cartesian_locus_roots_basic",
              "complex_numbers.locus_basic",
              "complex_numbers.modulus_argument_basic",
              "complex_numbers.roots_basic",
              "differential_equations.context_model_basic",
              "differential_equations.initial_condition_basic",
              "differential_equations.separation_basic",
              "differentiation.chain_product_basic",
              "differentiation.chain_rule_basic",
              "differentiation.implicit_log_exp_basic",
              "differentiation.product_rule_basic",
              "differentiation.stationary_tangent_normal_basic",
              "integration.definite_area_basic",
              "integration.method_setup_basic",
              "integration.parts_substitution_basic",
              "logarithms_and_exponentials.calculus_context_basic",
              "logarithms_and_exponentials.domain_validation_basic",
              "logarithms_and_exponentials.linearisation_basic",
              "logarithms_and_exponentials.log_equation_basic",
              "numerical_methods.accuracy_rounding_basic",
              "numerical_methods.iteration_formula_basic",
              "numerical_methods.sign_change_iteration_basic",
              "parametric_equations.derivative_ratio_basic",
              "quadratics.discriminant_root_condition_bridge",
              "quadratics.discriminant_root_condition_basic",
              "trigonometry.addition_formulae_basic",
              "trigonometry.double_angle_basic",
              "trigonometry.identity_rewrite_basic",
              "trigonometry.r_form_basic",
              "trigonometry.solve_equation_interval_basic",
              "vectors.line_intersection_basic",
              "vectors.line_relationship_basic",
              "vectors.line_scalar_product_basic"
            ]
          },
          "paper_family": { "type": "string", "minLength": 1 },
          "topic": { "type": "string", "minLength": 1 },
          "skill_target_id": { "type": "string", "minLength": 1 },
          "source_snippet_id": { "type": "string", "minLength": 1 },
          "example_model_id": { "type": "string", "minLength": 1 },
          "question_type": { "type": "string", "minLength": 1 },
          "key_method": { "type": "string", "minLength": 1 },
          "exam_move": { "type": "string", "minLength": 1 },
          "snippet_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "region_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "prompt": { "type": "string", "minLength": 1 },
          "answer": { "type": "string", "minLength": 1 },
          "worked_solution": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "parameters": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": ["string", "number", "integer", "boolean"]
            }
          },
          "sequence_role": { "enum": ["first_step", "complete_step", "guardian_prep"] },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "method", "verifier"],
            "properties": {
              "status": { "enum": ["pass", "fail"] },
              "method": { "enum": ["deterministic"] },
              "verifier": { "type": "string", "minLength": 1 }
            }
          },
          "difficulty_band": {
            "description": "Deprecated legacy metadata. Do not use for runtime readiness, routing, grouping, mastery, Guardian eligibility, or generation eligibility.",
            "enum": ["easy", "medium", "hard"]
          },
          "review_status": {
            "enum": ["candidate", "needs_review", "teacher_reviewed", "published", "blocked"]
          }
        }
      }
    }
  }
}
