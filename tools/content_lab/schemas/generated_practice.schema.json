{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterion.local/schemas/generated_practice.schema.json",
  "title": "Asterion Content Lab Generated Practice",
  "description": "Reviewed, deterministic, non-exam warm-up practice generated repo-side for static runtime use.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "generated_by", "items"],
  "properties": {
    "schema_name": { "const": "asterion_generated_practice" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "practice_id",
          "generator_family",
          "paper_family",
          "topic",
          "prompt",
          "answer",
          "worked_solution",
          "parameters",
          "verification",
          "difficulty_band",
          "review_status"
        ],
        "properties": {
          "practice_id": { "type": "string", "pattern": "^[a-z0-9_:-]+$" },
          "generator_family": {
            "enum": [
              "logarithms_and_exponentials.log_equation_basic",
              "binomial_expansion.first_terms_and_coefficient"
            ]
          },
          "paper_family": { "type": "string", "minLength": 1 },
          "topic": { "type": "string", "minLength": 1 },
          "skill_target_id": { "type": "string", "minLength": 1 },
          "snippet_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "region_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "prompt": { "type": "string", "minLength": 1 },
          "answer": { "type": "string", "minLength": 1 },
          "worked_solution": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "parameters": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": ["string", "number", "integer", "boolean"]
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "method", "verifier"],
            "properties": {
              "status": { "enum": ["pass", "fail"] },
              "method": { "enum": ["deterministic"] },
              "verifier": { "type": "string", "minLength": 1 }
            }
          },
          "difficulty_band": { "enum": ["easy", "medium", "hard"] },
          "review_status": {
            "enum": ["candidate", "needs_review", "teacher_reviewed", "published", "blocked"]
          }
        }
      }
    }
  }
}
