{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterion.local/schemas/teaching_snippet.schema.json",
  "title": "Asterion Reviewed Teaching Snippets",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "snippets"],
  "properties": {
    "schema_name": { "const": "asterion_teaching_snippets" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "snippets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snippet_id",
          "paper_family",
          "topics",
          "region_ids",
          "title",
          "student_goal",
          "body",
          "steps",
          "exam_move",
          "common_trap",
          "review_status",
          "source"
        ],
        "properties": {
          "snippet_id": { "type": "string", "pattern": "^[a-z0-9_:-]+$" },
          "paper_family": { "type": "string", "minLength": 1 },
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "region_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "title": { "type": "string", "minLength": 1 },
          "student_goal": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "exam_move": { "type": "string", "minLength": 1 },
          "common_trap": { "type": "string", "minLength": 1 },
          "review_status": { "enum": ["needs_review", "teacher_reviewed", "published"] },
          "source": { "enum": ["teacher_authored", "template_authored"] },
          "prerequisites": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "micro_steps": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "common_mistakes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "quick_check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prompt", "answer", "explanation"],
            "properties": {
              "prompt": { "type": "string", "minLength": 1 },
              "answer": { "type": "string", "minLength": 1 },
              "explanation": { "type": "string", "minLength": 1 }
            }
          },
          "guardian_readiness": {
            "type": "object",
            "additionalProperties": false,
            "required": ["supports_topics", "recommended_before_question_ids", "readiness_note"],
            "properties": {
              "supports_topics": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "recommended_before_question_ids": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "readiness_note": { "type": "string", "minLength": 1 }
            }
          },
          "estimated_time_minutes": { "type": "number", "exclusiveMinimum": 0 },
          "snippet_type": { "enum": ["concept", "method", "mistake_repair", "quick_check"] },
          "source_question_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "source_skill_target_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
