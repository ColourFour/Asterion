{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterion.local/schemas/teaching_snippet.schema.json",
  "title": "Asterion Reviewed Teaching Snippets Schema Contract v2",
  "description": "Backward-compatible teaching snippet schema with optional Worked Examples v1 metadata. Publishing rules may require optional fields for specific batches.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "snippets"],
  "properties": {
    "schema_name": { "const": "asterion_teaching_snippets" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "snippets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snippet_id",
          "paper_family",
          "topics",
          "region_ids",
          "title",
          "student_goal",
          "body",
          "steps",
          "exam_move",
          "common_trap",
          "review_status",
          "source"
        ],
        "properties": {
          "snippet_id": { "type": "string", "pattern": "^[a-z0-9_:-]+$" },
          "paper_family": { "type": "string", "minLength": 1 },
          "topic": { "type": "string", "minLength": 1 },
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "region_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "title": { "type": "string", "minLength": 1 },
          "student_goal": { "type": "string", "minLength": 1 },
          "explanation": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "exam_move": { "type": "string", "minLength": 1 },
          "common_trap": { "type": "string", "minLength": 1 },
          "review_status": { "enum": ["needs_review", "teacher_reviewed", "published"] },
          "source": { "enum": ["teacher_authored", "template_authored"] },
          "prerequisites": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "micro_steps": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "common_mistakes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "worked_example": {
            "$ref": "#/$defs/workedExample"
          },
          "worked_examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/workedExample"
            }
          },
          "quick_check": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "region_id",
              "topic",
              "skill_target_id",
              "title",
              "prompt",
              "answer",
              "explanation",
              "micro_skill",
              "difficulty_band",
              "estimated_time_minutes",
              "review_status"
            ],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_:-]+$" },
              "region_id": { "type": "string", "minLength": 1 },
              "topic": { "type": "string", "minLength": 1 },
              "skill_target_id": { "type": "string", "minLength": 1 },
              "example_model_id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "prompt": { "type": "string", "minLength": 1 },
              "answer": { "type": "string", "minLength": 1 },
              "explanation": { "type": "string", "minLength": 1 },
              "micro_skill": { "type": "string", "minLength": 1 },
              "difficulty_band": { "enum": ["easy", "medium", "hard"] },
              "estimated_time_minutes": { "type": "number", "exclusiveMinimum": 0 },
              "review_status": { "enum": ["teacher_reviewed", "published"] }
            }
          },
          "guardian_readiness": {
            "type": "object",
            "additionalProperties": false,
            "required": ["supports_topics", "recommended_before_question_ids", "readiness_note"],
            "properties": {
              "supports_topics": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "recommended_before_question_ids": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "readiness_note": { "type": "string", "minLength": 1 }
            }
          },
          "estimated_time_minutes": { "type": "number", "exclusiveMinimum": 0 },
          "snippet_type": { "enum": ["concept", "method", "mistake_repair", "quick_check", "guardian_prep"] },
          "source_question_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "source_skill_target_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "related_skill_targets": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "lineage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["generated_from"],
            "properties": {
              "generated_from": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "workedExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "steps", "answer"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_:-]+$" },
        "question_type": { "type": "string", "minLength": 1 },
        "key_method": { "type": "string", "minLength": 1 },
        "exam_move": { "type": "string", "minLength": 1 },
        "source_question_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "source_question_asset_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "source_mark_scheme_asset_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "prompt": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "answer": { "type": "string", "minLength": 1 },
        "teaching_note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
