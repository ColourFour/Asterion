# Browser-safe Vite config for the hosted classroom pilot.
# Copy values to .env.local for local checks, or set them in Vercel.

VITE_ASTERION_APP_PROFILE=classroom-pilot
VITE_CHINA_STATIC_PILOT=
VITE_ASTERION_STORAGE_MODE=local
VITE_ASTERION_DASHBOARD_DEMO=
VITE_ASTERION_DASHBOARD_DATA_SOURCE=supabase
VITE_ASTERION_STUDENT_CLAIM_SOURCE=supabase
VITE_ASSET_BASE_URL=
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-browser-safe-publishable-key
