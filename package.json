{
  "name": "asterion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run preview",
    "dev:student-pilot": "npm run dev",
    "dev:classroom-pilot": "npm run dev",
    "dev:china-static-pilot": "npm run dev",
    "build": "tsc -b && vite-node scripts/build-static-site.ts",
    "build:dist": "tsc -b && STATIC_SITE_OUTPUT_DIR=dist vite-node scripts/build-static-site.ts",
    "build:student-pilot": "npm run build",
    "build:classroom-pilot": "npm run build",
    "build:china-static-pilot": "npm run build",
    "static:check": "node scripts/check-static-site.mjs && node scripts/check-rendered-static-site.mjs",
    "assets:sync": "node scripts/sync-exam-bank-assets.mjs",
    "assets:ui": "node scripts/optimize-ui-assets.mjs",
    "assets:region": "node scripts/optimize-region-assets.mjs",
    "data:p3": "vite-node scripts/generate-p3-data.ts",
    "preview": "vite preview --outDir docs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:verify": "node scripts/verify-supabase-schema.mjs",
    "supabase:verify:live": "node scripts/verify-supabase-rls-live.mjs",
    "test": "vitest run",
    "test:student-readiness-browser": "node scripts/student-readiness-browser-smoke.mjs",
    "test:unit": "vitest run --exclude tests/contentLabPipeline.test.ts --exclude tests/generatedPracticePipeline.test.ts",
    "test:pipeline": "vitest run tests/contentLabPipeline.test.ts tests/generatedPracticePipeline.test.ts --pool=forks --maxWorkers=1 --minWorkers=1 --no-file-parallelism",
    "test:ci": "vitest run --pool=forks --maxWorkers=2 --minWorkers=1 --no-file-parallelism",
    "validate:p3-skill-map": "python3 tools/content_lab/scripts/build_p3_skill_coverage.py --output tools/content_lab/reports/p3_skill_coverage_report.json",
    "inventory:p3-content": "python3 tools/content_lab/scripts/build_p3_content_inventory.py --output tools/content_lab/reports/p3_content_inventory_report.json",
    "coverage:p3-matrix": "python3 tools/content_lab/scripts/build_p3_coverage_matrix.py --json-output tools/content_lab/reports/p3_coverage_matrix.json --markdown-output tools/content_lab/reports/p3_coverage_matrix.md",
    "queue:p3-region-correction": "python3 tools/content_lab/scripts/build_p3_region_correction_queue.py --json-output tools/content_lab/reports/p3_region_correction_queue.json --markdown-output tools/content_lab/reports/p3_region_correction_queue.md",
    "report:p3-route-evidence": "python3 tools/content_lab/scripts/build_p3_route_evidence_report.py --json-output tools/content_lab/reports/p3_route_evidence_status_report.json --markdown-output tools/content_lab/reports/p3_route_evidence_status_report.md",
    "report:p3-gold-skill-packs": "python3 tools/content_lab/scripts/build_p3_gold_skill_pack_readiness.py --json-output tools/content_lab/reports/p3_gold_skill_pack_readiness.json --markdown-output tools/content_lab/reports/p3_gold_skill_pack_readiness.md",
    "audit:legacy-skill-targets": "python3 tools/content_lab/scripts/audit_legacy_skill_targets.py",
    "verify:content-lab": "python3 tools/content_lab/scripts/verify_content_lab_outputs.py",
    "content-lab:verify": "npm run validate:p3-skill-map && npm run inventory:p3-content && npm run coverage:p3-matrix && npm run report:p3-gold-skill-packs && npm run queue:p3-region-correction && python3 tools/content_lab/scripts/verify_content_lab_outputs.py && npm test && npm run build && git diff --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@vitejs/plugin-react": "^4.3.4",
    "katex": "^0.16.45",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8"
  }
}
