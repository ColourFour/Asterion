{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/data/**/*.ts",
    "src/lib/courseExamTraining.ts",
    "src/lib/generatedPractice.ts",
    "src/lib/loadQuestionBank.ts",
    "src/lib/normalizeQuestionBank.ts",
    "src/lib/p3SkillContract.ts",
    "src/lib/questionRouteEvidence.ts",
    "src/lib/questionTraining.ts",
    "src/lib/quickCheckAnswer.ts",
    "src/lib/regionThemes.ts",
    "src/lib/resolveAssetPath.ts",
    "src/lib/skillChecklist.ts",
    "src/lib/staticStudyRoutes.ts",
    "src/lib/teachingSnippets.ts",
    "src/lib/topicRouting.ts",
    "src/lib/topicStudy.ts",
    "src/lib/worldMap.ts",
    "src/skill-checks/**/*.ts",
    "src/types.ts",
    "src/vite-env.d.ts"
  ],
  "exclude": [
    "src/tests",
    "src/components",
    "src/App.tsx",
    "src/main.tsx"
  ]
}
