# Browser-safe Vite config only. Copy needed lines to .env.local.
# Defaults when omitted: student-pilot profile, local storage, dashboard routes off, mock dashboard data, mock class claims.

# App profile: student-pilot is static-hosting compatible and browser-local.
# Use classroom-pilot only with hosted Supabase classroom config.
VITE_ASTERION_APP_PROFILE=student-pilot

# Demo dashboard route access: enabled opens mock demo routes.
VITE_ASTERION_DASHBOARD_DEMO=

# Dashboard data source: mock or supabase. The classroom-pilot profile forces supabase.
VITE_ASTERION_DASHBOARD_DATA_SOURCE=mock

# Student class claim source: mock or supabase. The classroom-pilot profile forces supabase.
VITE_ASTERION_STUDENT_CLAIM_SOURCE=mock

# Storage mode: local or hosted. Student raw practice work remains local in current builds.
VITE_ASTERION_STORAGE_MODE=local

# Optional public asset host prefix.
VITE_ASSET_BASE_URL=

# Browser-safe Supabase config for Supabase dashboard, claim, and health features.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-browser-safe-publishable-key
